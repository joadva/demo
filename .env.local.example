# Copia este archivo a .env.local para apuntar `npm run demo` y `npm run db:init`
# a una base de datos distinta de la del docker-compose.yaml (por ejemplo una
# MySQL en la nube). Sin este archivo se usan las credenciales de Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=demo
DB_PASSWORD=demo
DB_DATABASE=demo
